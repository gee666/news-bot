# Copy to .env, chmod 600 .env, then fill in secrets. Never commit .env.
POSTGRES_USER=newsbot
POSTGRES_DB=newsbot
POSTGRES_PASSWORD=
DB_PORT=5432
WEB_PORT=3000
# Development server stays on loopback; Compose explicitly binds inside its container.
HOST=127.0.0.1
PORT=3000
APP_ALLOWED_HOSTS=
MODEL_USAGE_RETRY_MS=30000
# Optional persistent owner-private override; Compose defaults to /data/pi/usage-outbox.
# MODEL_USAGE_OUTBOX_DIR=/data/pi/usage-outbox
# Development uses PostgreSQL's standard PG* variables, not Compose's POSTGRES_*.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=newsbot
PGPASSWORD=
PGDATABASE=newsbot
# Alternatively set DATABASE_URL privately. Compose always uses db:5432.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# Bot API deadlines in milliseconds. Uploads need longer for original media bytes.
# Terminal send/edit retry window, measured from first attempt or staging if never attempted.
PUBLICATION_RETRY_WINDOW_MS=14400000
TELEGRAM_REQUEST_TIMEOUT_MS=30000
TELEGRAM_UPLOAD_TIMEOUT_MS=300000
TELEGRAM_DESTINATION=https://t.me/+5cDKe78ahR02Y2Ey
TELEGRAM_SESSION_DIR=./tmp/private/telegram
PI_AUTH_DIR=./tmp/private/pi
PI_AUTH_PATH=./tmp/private/pi/auth.json
JEV_API_KEY=
JEV_URL=http://localhost:8765
EMBEDDING_URL=http://localhost:11434
JEV_DOCKER_URL=http://host.docker.internal:8765
EMBEDDING_DOCKER_URL=http://host.docker.internal:11434
# Optional settings seed overrides; later changes use the settings UI.
JEV_MODEL=autojev
EMBEDDING_MODEL=qwen3-embedding:latest
EMBEDDING_DIMENSIONS=4096
# Maximum generated news-body characters, excluding headline and source links, 200..2000.
NEWS_SUMMARY_MAX_CHARS=1000
# NEWS_ avoids reading the running coding agent's PI_MODEL environment.
NEWS_PI_PROVIDER=openai-codex
NEWS_PI_MODEL=gpt-6-luna
# Grouping evidence JSON limits per request. Full candidates continue in cached chunks.
# Cooperative batch slice in milliseconds, range 1000..3600000. In-flight stages finish normally.
PROCESSING_SLICE_MS=120000
# Do not enable without approving private/unknown source content for external inference.
ALLOW_PRIVATE_INFERENCE=false
# Optional PUBLIC SearxNG-compatible JSON endpoint. Default search uses Bing RSS.
RESEARCH_SEARCH_URL=
RESEARCH_SEARCH_TOKEN=
RESEARCH_FETCH_TIMEOUT_MS=15000
RESEARCH_FETCH_MAX_BYTES=1000000
# Private Compose Crawl4AI service. Compose sets its internal URL automatically.
CRAWL4AI_API_TOKEN=
RESEARCH_CRAWLER_TIMEOUT_MS=60000
RESEARCH_CRAWLER_MAX_BYTES=5000000
# Comma-separated fetch-priority hints, not automatic primary-source trust.
RESEARCH_PREFERRED_DOMAINS=

# Maximum still images sent with each summarization request, 1 through 10. Videos are excluded.
MEDIA_SUMMARY_MAX_IMAGES=10
# Relative duration difference above which videos are distinct.
MEDIA_VIDEO_DURATION_TOLERANCE=0.2
