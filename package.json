{
  "name": "personal-news-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db.ts",
    "migrate:production": "node dist/db.js",
    "cli:production": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src web vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:db": "vitest run src/db.test.ts src/schema.test.ts",
    "build": "tsc && vite build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@huggingface/tokenizers": "0.2.0",
    "@mozilla/readability": "^0.6.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.1",
    "mdast-util-to-string": "^4.0.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "telegram": "^2.26.22",
    "undici": "^7.30.0",
    "unified": "^11.0.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
